# ============================================================================
# MONEYMAKER — Configuration des clés API
# ============================================================================
# Copie ce fichier en `.env` et remplis les clés que tu possèdes.
# Le système fonctionne avec ce qui est disponible et signale clairement
# ce qui manque — il n'invente JAMAIS de données.
#
# Sur GitHub Actions : ajoute ces valeurs dans
#   Settings → Secrets and variables → Actions → New repository secret
# ============================================================================

# ----------------------------------------------------------------------------
# SOURCE PRINCIPALE — vrais volumes de recherche Google (PAYANT, pay-as-you-go)
# ----------------------------------------------------------------------------
# DataForSEO donne les VRAIS volumes de recherche mensuels + compétition réelle.
# C'est ce qui transforme le système d'estimations en vraies valeurs de marché.
# Modèle pay-as-you-go (pas d'abonnement) : ~0,05 $ pour 1000 mots-clés.
# Inscription : https://app.dataforseo.com/register
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# ----------------------------------------------------------------------------
# MARCHÉ POD / NUMÉRIQUE — vraie compétition (GRATUIT)
# ----------------------------------------------------------------------------
# Etsy API v3 : nombre réel de listings actifs, tags réels, prix réels.
# Inscription gratuite : https://www.etsy.com/developers/register
ETSY_API_KEY=

# ----------------------------------------------------------------------------
# BUZZ COMMUNAUTAIRE — vrai engagement (GRATUIT)
# ----------------------------------------------------------------------------
# Reddit API OAuth (bien plus stable que le scraping anonyme bloqué en 403).
# Créer une app "script" : https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=Moneymaker/1.0

# ----------------------------------------------------------------------------
# DEMANDE VIDÉO — vraies vues (GRATUIT, quota 10 000 unités/jour)
# ----------------------------------------------------------------------------
# YouTube Data API v3 : vues réelles des tutoriels = intérêt réel pour une niche.
# Console : https://console.cloud.google.com (activer "YouTube Data API v3")
YOUTUBE_API_KEY=

# ----------------------------------------------------------------------------
# OPTIONNEL — génération d'images (modules futurs)
# ----------------------------------------------------------------------------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
