# ============================================================================
# MONEYMAKER — Configuration des clés API
# ============================================================================
# Copie ce fichier en `.env` et remplis les clés que tu possèdes.
# Le système fonctionne avec ce qui est disponible et signale clairement
# ce qui manque — il n'invente JAMAIS de données.
#
# Sur GitHub Actions : ajoute ces valeurs dans
#   Settings → Secrets and variables → Actions → New repository secret
# ============================================================================

# ============================================================================
# DÉMARRAGE RAPIDE — 2 clés suffisent pour un système complet :
#
#   1. GEMINI_API_KEY  → trouve les trends mondiaux sur le web (GRATUIT)
#      https://aistudio.google.com/app/apikey
#
#   2. RUNWARE_API_KEY → génère 5 images Spoonflower (~0,03 $ les 5)
#      https://runware.ai
#
# Wikipedia fonctionne SANS clé (demande + croissance réelles).
# ============================================================================

# ----------------------------------------------------------------------------
# TENDANCES MONDIALES — web search temps réel (GRATUIT)
# ----------------------------------------------------------------------------
# Gemini 2.0 Flash + Google Search : trouve les niches qui montent EN CE MOMENT
# partout dans le monde (anglais, toutes langues). Remplace les scrapers anonymes.
# Inscription gratuite : https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# ----------------------------------------------------------------------------
# GÉNÉRATION D'IMAGES — PNG 300 DPI prêt Spoonflower (PAY-AS-YOU-GO)
# ----------------------------------------------------------------------------
# Runware : génération Stable Diffusion / Flux + upscale ×4 automatique
# ~0,003-0,008 $ par image finale. 5 images ≈ 0,03 $.
# Inscription : https://runware.ai
RUNWARE_API_KEY=
# Modèle : "runware:100@1" (SDXL) par défaut. Changer pour Flux pour + qualité.
# Liste des modèles : https://runware.ai/models
RUNWARE_MODEL=runware:100@1

# ----------------------------------------------------------------------------
# SOURCE OPTIONNELLE — vrais volumes de recherche Google (PAYANT)
# ----------------------------------------------------------------------------
# DataForSEO : volumes mensuels réels + compétition. ~0,05 $ / 1000 mots-clés.
# Inscription : https://app.dataforseo.com/register
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# ----------------------------------------------------------------------------
# MARCHÉ POD — vraie compétition Etsy (GRATUIT)
# ----------------------------------------------------------------------------
# Etsy API v3 : nombre réel de listings actifs, tags réels, prix réels.
# Inscription : https://www.etsy.com/developers/register
ETSY_API_KEY=

# ----------------------------------------------------------------------------
# BUZZ COMMUNAUTAIRE — Reddit (GRATUIT)
# ----------------------------------------------------------------------------
# Reddit API OAuth : créer une app "script" sur https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=Moneymaker/1.0

# ----------------------------------------------------------------------------
# DEMANDE VIDÉO — YouTube (GRATUIT, quota 10 000 unités/jour)
# ----------------------------------------------------------------------------
# YouTube Data API v3 : vues réelles = intérêt réel pour une niche.
# Console : https://console.cloud.google.com (activer "YouTube Data API v3")
YOUTUBE_API_KEY=

# ----------------------------------------------------------------------------
# OPTIONNEL — modules futurs
# ----------------------------------------------------------------------------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
